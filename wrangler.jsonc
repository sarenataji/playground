{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sarena-notes",
  "account_id": "e10330ae87e731bb6a8dd05cef749390",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sarena-playground-notes",
      "database_id": "b6c940c6-5e42-479c-a8e4-bfd950d6cbe9",
      "migrations_dir": "cloudflare/migrations"
    }
  ],
  "vars": {
    "OWNER_EMAIL": "sarenataji@gmail.com",
    "PUBLIC_SITE_URL": "https://sarena-playground.vercel.app",
    "ACCESS_TEAM_DOMAIN": "laurentlo.cloudflareaccess.com",
    "ACCESS_AUD": "4b61bb38ee94babb6080a0873e54b3f8084f06a6c9188dbcaea77e5ec42bb5cd"
  }
}
