{
  "rewrites": [
    {
      "source": "/leave-a-note",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/notes-sync",
      "schedule": "0 9 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/my-notes",
      "destination": "https://sarena-notes.llabs.workers.dev/my-notes",
      "permanent": false
    }
  ]
}
