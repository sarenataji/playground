# Public browser configuration (safe to expose)
VITE_NOTES_ORIGIN=https://sarena-notes.llabs.workers.dev

# Vercel server only. Never prefix secrets with VITE_.
NOTES_WORKER_URL=https://sarena-notes.llabs.workers.dev
NOTES_PROXY_SECRET=GENERATE_A_RANDOM_SECRET_SHARED_WITH_THE_WORKER
NOTES_RATE_LIMIT_SECRET=GENERATE_A_RANDOM_SECRET_SHARED_WITH_THE_WORKER
BLOB_READ_WRITE_TOKEN=YOUR_PRIVATE_BLOB_READ_WRITE_TOKEN
CRON_SECRET=GENERATE_ANOTHER_RANDOM_SECRET

# Cloudflare's non-secret D1 and Access bindings are in wrangler.jsonc.
# Store NOTES_PROXY_SECRET and NOTES_RATE_LIMIT_SECRET using wrangler secret.
